#!/bin/sh
set -eu

command -v git-lfs >/dev/null 2>&1 || {
    echo "Git LFS is required for this repository. Install Git LFS before pushing." >&2
    exit 2
}

# Git LFS must receive the original args and all ref updates exactly as Git supplied them.
scratch=$(mktemp -d)
push_updates="$scratch/updates"
validator="$scratch/check-art-branch.py"
trap 'rm -f -- "$push_updates" "$validator"; rmdir -- "$scratch"' EXIT
trap 'exit 1' HUP INT TERM
cat >"$push_updates"

base=
while read -r local_ref local_oid remote_ref remote_oid; do
    [ "$local_ref" != '(delete)' ] || continue
    case "$local_ref:$remote_ref" in
        refs/heads/art/*:refs/heads/art/*)
            if [ "$local_ref" != "$remote_ref" ]; then
                echo "Push the art branch under its own name: $local_ref" >&2
                exit 1
            fi
            ;;
        refs/heads/art/*:refs/heads/main)
            echo "Open a pull request from $local_ref to main." >&2
            exit 1
            ;;
    esac
    case "$local_ref:$remote_ref" in
        refs/heads/art/*:*) art_ref=$local_ref ;;
        *:refs/heads/art/*) art_ref=$remote_ref ;;
        *) continue ;;
    esac

    if [ -z "$base" ]; then
        base_remote=$2
        if git remote get-url origin >/dev/null 2>&1; then
            base_remote=origin
        fi
        if ! base_line=$(git ls-remote --exit-code -- "$base_remote" refs/heads/main); then
            echo "The art guard needs main on $base_remote." >&2
            exit 1
        fi
        base=$(printf '%s\n' "$base_line" | cut -f1)
        if ! git --no-replace-objects show "$base:tools/check-art-branch.py" >"$validator"; then
            echo "Fetch main from $base_remote and confirm it contains the art guard before pushing." >&2
            exit 1
        fi
        if command -v python >/dev/null 2>&1; then
            python_cmd=python
        else
            python_cmd=python3
        fi
        command -v "$python_cmd" >/dev/null 2>&1 || {
            echo "Python 3 is required to check art branches." >&2
            exit 2
        }
    fi
    "$python_cmd" -I "$validator" --base "$base" --head "$local_oid" \
        --branch "${art_ref#refs/heads/}"
done <"$push_updates"

git lfs pre-push "$@" <"$push_updates"
